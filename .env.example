# Copy to .env and fill in. NEVER commit .env. Generate everything below with:
#   python -m tracevault.keygen > .env
# (To keep an existing deployment's data readable: python -m tracevault.keygen --migrate ./data > .env)

# --- Required secrets ---------------------------------------------------------
# AES-256 key (base64 of 32 random bytes) that encrypts the document vault in SQLite.
# Losing or changing it makes stored documents unrecoverable.
TV_MASTER_KEY=

# HMAC secret used to sign login tokens (JWT, HS256). >= 32 characters. Changing it logs everyone out.
TV_JWT_SECRET=

# ML-DSA-65 signing key pair of each ledger node, as <base64 public>:<base64 secret>.
TV_NODE_1_KEY=
TV_NODE_2_KEY=
TV_NODE_3_KEY=
TV_NODE_4_KEY=

# --- First-run administrator (created only if no user with this name exists) ---
TV_ADMIN_USER=admin
TV_ADMIN_PASSWORD=

# --- Optional ------------------------------------------------------------------
# Login token lifetime in minutes (default 60).
TV_JWT_TTL_MINUTES=60
# Max evidence upload size in MB (default 25).
TV_MAX_UPLOAD_MB=25
# Seconds to wait for a ledger file lock before failing a request (default 30).
TV_LOCK_TIMEOUT=30
# Where per-user encrypted keystores (<user>.keys) live. Alternatively set TV_KEYSTORE_<USER> to the
# base64 keystore blob (see KeyStore.export_blob) and no file is needed. Passphrases are never stored.
TV_KEYSTORE_DIR=
# Comma-separated browser origins allowed to call the API (leave empty: same-origin only).
TV_CORS_ORIGINS=
